# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# Home page
GET     /                                       Gerenciamentos.principal

# Rotas de Login/Logout
GET     /login                                  Logins.form
POST    /login                                  Logins.logar
GET     /logout                                 Logins.logout

# Rotas do Perfil do Cliente
GET     /cliente/perfil                         ClientesPerfil.perfil
GET     /cliente/editar                         ClientesPerfil.editarPerfil
POST    /cliente/atualizar                      ClientesPerfil.atualizarPerfil

# Rotas de Cadastro de Cliente/Proprietário
GET     /gerenciamentos/formcadastro            Gerenciamentos.formCadastro
GET     /gerenciamentos/formproprietario        Gerenciamentos.formCadastroProprietario
POST    /gerenciamentos/salvar                  Gerenciamentos.salvar
POST    /gerenciamentos/salvarproprietario      Gerenciamentos.salvarProprietario

# --- NOVA ROTA DE GEOLOCALIZAÇÃO ---
# É esta rota que o JavaScript do botão "Perto de Mim" chama
GET     /proximos                               Gerenciamentos.listarPorDistancia

# Rotas Específicas de Restaurantes
POST    /restaurantes/salvar                    Restaurantes.salvar
POST    /restaurantes/trocarStatusAjax          Restaurantes.trocarStatusAjax

# Rotas de Favoritos
POST    /favoritos/ajax                         Favoritos.favoritarAjax
GET     /favoritos                              Favoritos.index

# Ignore favicon requests
GET     /favicon.ico                            404

# Map static resources
GET     /public/                                staticDir:public
GET     /uploads/                               staticDir:uploads

# Catch all (MANTENHA SEMPRE POR ÚLTIMO)
*       /{controller}/{action}                  {controller}.{action}

